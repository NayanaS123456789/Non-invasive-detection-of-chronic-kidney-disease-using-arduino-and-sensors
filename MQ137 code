#define RL 47
#define m -0.263
#define b 0.42
#define Ro 40
#define MQ_sensor A0

#include <LiquidCrystal.h>
#include <math.h>

const int rs = 12, en = 11, d4 = 2, d5 = 3, d6 = 4, d7 = 5;

LiquidCrystal lcd(rs, en, d4, d5, d6, d7);

void setup() {
    Serial.begin(9600);

    lcd.begin(16, 2);
    lcd.print("NH3 in PPM");

    lcd.setCursor(0, 1);
    lcd.print("-CircuitDigest");

    delay(2000);
    lcd.clear();
}

void loop() {
    float VRL;
    float Rs;
    float ratio;
    float ppm;

    VRL = analogRead(MQ_sensor) * (5.0 / 1023.0);

    if (VRL <= 0.0) {
        Serial.println("Invalid sensor voltage");
        lcd.clear();
        lcd.print("Sensor Error");
        delay(2000);
        return;
    }

    Rs = ((5.0 * RL) / VRL) - RL;
    ratio = Rs / Ro;

    if (ratio > 0.0) {
        ppm = pow(10, ((log10(ratio) - b) / m));

        Serial.print("NH3 (ppm) = ");
        Serial.println(ppm);

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("NH3 = ");
        lcd.print(ppm, 2);
        lcd.print(" ppm");

        lcd.setCursor(0, 1);
        lcd.print("Voltage=");
        lcd.print(VRL, 2);
        lcd.print("V");
    } else {
        Serial.println("Invalid sensor ratio");
        lcd.clear();
        lcd.print("Check Sensor");
    }

    delay(2000);
}
